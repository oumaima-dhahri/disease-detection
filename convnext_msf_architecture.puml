@startuml ConvNeXt_MSF_RoundedRoad

title ConvNeXt + Multi-Scale Fusion (Rounded Road Style)

skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam rectangle {
    RoundCorner 25
    BackgroundColor #FDF9F2
    BorderColor #3B3A30
    FontColor #1F2933
}
skinparam ArrowColor #3B3A30
skinparam ArrowThickness 2

!define BACKBONE_COLOR #E8F1FF
!define MSF_COLOR #E8FFFA
!define HEAD_COLOR #FCE4EC

rectangle "Input Image\n320x320x3" as Input #BACKBONE_COLOR
rectangle "Patchify Stem\n4x4 conv, stride 4\n(Conv -> LN -> GELU)" as Stem #BACKBONE_COLOR
rectangle "Stage 1\n128 ch @ 80x80\nDWConv7x7 + MLP" as Stage1 #BACKBONE_COLOR
rectangle "Stage 2\n256 ch @ 40x40\nDWConv7x7 + MLP" as Stage2 #BACKBONE_COLOR
rectangle "Stage 3\n512 ch @ 20x20\nDWConv7x7 + MLP" as Stage3 #BACKBONE_COLOR
rectangle "Stage 4\n1024 ch @ 10x10\nDWConv7x7 + MLP" as Stage4 #BACKBONE_COLOR

rectangle "MSF Branch 3x3\nGrouped Conv -> 1x1\ncaptures fine lesions" as MSF3 #MSF_COLOR
rectangle "MSF Branch 5x5\nGrouped Conv -> 1x1\ncaptures mid-scale rust" as MSF5 #MSF_COLOR
rectangle "MSF Branch 7x7\nGrouped Conv -> 1x1\ncaptures large blights" as MSF7 #MSF_COLOR
rectangle "Concat + 1x1 Fusion\nLayerNorm + residual\nF_out = Conv1x1([F3,F5,F7])" as Fusion #MSF_COLOR

rectangle "Adaptive Avg Pool" as GAP #HEAD_COLOR
rectangle "Classifier Head\nLayerNorm -> Linear 1024->512 -> GELU -> Dropout -> Linear 512->12" as Head #HEAD_COLOR
rectangle "Softmax Outputs\n12 wheat disease classes" as Output #HEAD_COLOR

Input --> Stem
Stem --> Stage1
Stage1 --> Stage2
Stage2 --> Stage3
Stage3 --> Stage4

Stage4 --> MSF3
Stage4 --> MSF5
Stage4 --> MSF7

MSF3 --> Fusion
MSF5 --> Fusion
MSF7 --> Fusion

Fusion --> GAP
GAP --> Head
Head --> Output

note right of Stage4
  ConvNeXt block math:
  X_tilde_s = DWConv7x7(X_s)
  Z_s = LN(X_tilde_s)
  U_s = W2 * sigma(W1 * Z_s)
  F_s = X_s + DropPath(U_s)
end note

legend right
  |<#E8F1FF> ConvNeXt Backbone|
  |<#E8FFFA> Multi-Scale Fusion|
  |<#FCE4EC> Classification Head|
  |Rounded "road" flow shows|
  |hierarchical processing|
endlegend

@enduml

