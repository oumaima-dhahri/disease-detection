@startuml ProtoPNet_Architecture

!define BACKBONE_COLOR #E8F1FF
!define PROTOTYPE_COLOR #FFF4E6
!define SIMILARITY_COLOR #E8FFFA
!define CLASSIFIER_COLOR #FCE4EC

title ProtoPNet Architecture\n(Prototype-Based Interpretable Classification)

skinparam component {
    BackgroundColor<<Backbone>> BACKBONE_COLOR
    BackgroundColor<<Prototype>> PROTOTYPE_COLOR
    BackgroundColor<<Similarity>> SIMILARITY_COLOR
    BackgroundColor<<Classifier>> CLASSIFIER_COLOR
    BorderColor #333333
    ArrowColor #333333
}

package "Input Layer" {
    component [Input Image\n224x224x3 RGB] as Input
}

package "Convolutional Layers f" <<Backbone>> {
    component [ResNet18 Backbone] as ResNet18
    component [Conv1 + BN + ReLU] as Conv1
    component [MaxPool] as MaxPool
    component [Layer1\n(2 Basic Blocks)] as Layer1
    component [Layer2\n(2 Basic Blocks)] as Layer2
    component [Layer3\n(2 Basic Blocks)] as Layer3
    component [Layer4\n(2 Basic Blocks)] as Layer4
    component [Feature Maps\n512 channels x H x W] as Features
}

package "Prototype Layer g_p" <<Prototype>> {
    component [Prototype Vectors\n128 prototypes\n512 channels x 1 x 1] as Prototypes
    component [L2 Distance Calculation\nL2(features - prototype)^2] as L2Dist
    component [Similarity Map 1\ng_p1 (H x W)] as SimMap1
    component [Similarity Map 2\ng_p2 (H x W)] as SimMap2
    component [Similarity Map ...\ng_p... (H x W)] as SimMapDot
    component [Similarity Map m\ng_pm (H x W)] as SimMapM
}

package "Similarity Aggregation" <<Similarity>> {
    component [Global Min Pooling\nover spatial dimensions] as MinPool
    component [Similarity Score 1\ns_1] as SimScore1
    component [Similarity Score 2\ns_2] as SimScore2
    component [Similarity Score ...\ns_...] as SimScoreDot
    component [Similarity Score m\ns_m] as SimScoreM
    component [Similarity Vector\n128 dims] as SimVector
}

package "Fully Connected Layer h" <<Classifier>> {
    component [Linear Layer\n128 -> 12] as FC
    component [Output Logits\n12 classes] as Output
}

' Input flow
Input --> ResNet18

' ResNet18 backbone flow
ResNet18 --> Conv1
Conv1 --> MaxPool
MaxPool --> Layer1
Layer1 --> Layer2
Layer2 --> Layer3
Layer3 --> Layer4
Layer4 --> Features

' Prototype layer flow
Features --> L2Dist
Prototypes --> L2Dist
L2Dist --> SimMap1
L2Dist --> SimMap2
L2Dist --> SimMapDot
L2Dist --> SimMapM

' Similarity aggregation flow
SimMap1 --> MinPool
SimMap2 --> MinPool
SimMapDot --> MinPool
SimMapM --> MinPool
MinPool --> SimScore1
MinPool --> SimScore2
MinPool --> SimScoreDot
MinPool --> SimScoreM
SimScore1 --> SimVector
SimScore2 --> SimVector
SimScoreDot --> SimVector
SimScoreM --> SimVector

' Classification flow
SimVector --> FC
FC --> Output

note right of Features
  **Feature Extraction:**
  - ResNet18 backbone (pretrained)
  - Removed avgpool & fc layers
  - Output: 512-channel feature maps
  - Spatial dimensions: H x W
end note

note right of Prototypes
  **Learnable Prototypes:**
  - 128 prototype vectors
  - Each: 512 channels x 1 x 1
  - Learned during training
  - Represent visual patterns
end note

note right of L2Dist
  **Distance Calculation:**
  L2 distance formula:
  d^2 = L2(x - p)^2
  = L2(x)^2 - 2(x*p) + L2(p)^2
  Computed via convolution
end note

note right of MinPool
  **Global Min Pooling:**
  Takes minimum distance
  (maximum similarity)
  over spatial dimensions
  for each prototype
end note

note right of FC
  **Classification:**
  - Linear layer: 128 -> 12
  - Weights learned during training
  - Each class uses different
    prototype combinations
end note

note right of Output
  **Output Classes:**
  1. aphid
  2. army_worm
  3. black_rust
  4. brown_rust
  5. common_rust
  6. fusarium_head_blight
  7. healthy
  8. leaf_blight
  9. powdery_mildew_leaf
  10. spetoria
  11. tan_spot
  12. yellow_rust
end note

legend right
  |<#E8F1FF> Convolutional Backbone |
  |<#FFF4E6> Prototype Layer |
  |<#E8FFFA> Similarity Aggregation |
  |<#FCE4EC> Classifier |
  |
  **Model Statistics:**
  - Base Model: ResNet18
  - Prototypes: 128 (learnable)
  - Feature Channels: 512
  - Input Size: 224x224x3
  - Output Classes: 12
  - Interpretability: High
  |
  **Key Features:**
  - Prototype-based explanations
  - Visual similarity maps
  - "Because it contains regions
    similar to these prototypes"
endlegend

@enduml

