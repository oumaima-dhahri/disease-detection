@startuml ConvNeXt_MSF_Architecture
!theme plain
skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam defaultFontSize 12
skinparam defaultFontName Arial
skinparam rectangle {
    FontSize 11
    FontName Arial
    FontStyle bold
}

title ConvNeXt with Multi-Scale Fusion Architecture

' Define colors
skinparam rectangle {
    Input #FFB6C1
    Stem #87CEEB
    ConvBlock #20B2AA
    Downsample #D2B48C
    MSFBranch1 #90EE90
    MSFBranch2 #87CEFA
    MSFBranch3 #FFA500
    Fusion #DDA0DD
    Pooling #DEB887
    LayerNorm #E6E6FA
    Dropout #20B2AA
    Flatten #9370DB
    Linear #FF6347
    GELU #98FB98
    Output #8B0000
}

rectangle "Input Image\n(320×320×3)" as Input #FFB6C1

package "ConvNeXt Backbone" #FFFFFF {
    rectangle "Stem\n4×4 Conv, Stride 4" as Stem #87CEEB
    rectangle "Stage 1\n3 ConvNeXt Blocks\n128 Channels" as Stage1 #20B2AA
    rectangle "Downsample\n2×2 Conv" as DS1 #D2B48C
    rectangle "Stage 2\n3 ConvNeXt Blocks\n256 Channels" as Stage2 #20B2AA
    rectangle "Downsample\n2×2 Conv" as DS2 #D2B48C
    rectangle "Stage 3\n9 ConvNeXt Blocks\n512 Channels" as Stage3 #20B2AA
    rectangle "Downsample\n2×2 Conv" as DS3 #D2B48C
    rectangle "Stage 4\n3 ConvNeXt Blocks\n1024 Channels" as Stage4 #20B2AA
}

rectangle "Feature Map\n(1024×10×10)" as FeatureMap #E6E6FA

' Multi-Scale Fusion Module - Horizontal layout
together {
    rectangle "Branch 1\n3×3 Depthwise Conv\n1×1 Pointwise Conv\nBatchNorm + GELU" as Branch1 #90EE90
    rectangle "Branch 2\n5×5 Depthwise Conv\n1×1 Pointwise Conv\nBatchNorm + GELU" as Branch2 #87CEFA
    rectangle "Branch 3\n7×7 Depthwise Conv\n1×1 Pointwise Conv\nBatchNorm + GELU" as Branch3 #FFA500
}
rectangle "Concatenate\n(3×1024 channels)" as Concat #DDA0DD
rectangle "Fusion Layer\n1×1 Conv + BatchNorm" as Fusion #DDA0DD

rectangle "Fused Features\n(1024)" as Fused #E6E6FA

' Enhanced Classifier Head - Horizontal layout
together {
    rectangle "AdaptiveAvgPool2d(1)" as AvgPool #DEB887
    rectangle "Flatten" as Flatten #9370DB
    rectangle "LayerNorm\n(1024)" as LN1 #E6E6FA
    rectangle "Dropout\n(0.2)" as Drop1 #20B2AA
    rectangle "Linear Layer\n1024 → 768" as Linear1 #FF6347
    rectangle "GELU\nActivation" as GELU1 #98FB98
    rectangle "Dropout\n(0.3)" as Drop2 #20B2AA
    rectangle "Linear Layer\n768 → 384" as Linear2 #FF6347
    rectangle "GELU\nActivation" as GELU2 #98FB98
    rectangle "Dropout\n(0.2)" as Drop3 #20B2AA
    rectangle "Linear Layer\n384 → 12" as Linear3 #FF6347
}

rectangle "Output\n12 Disease Classes" as Output #8B0000

' Flow connections - Backbone (vertical)
Input --> Stem
Stem --> Stage1
Stage1 --> DS1
DS1 --> Stage2
Stage2 --> DS2
DS2 --> Stage3
Stage3 --> DS3
DS3 --> Stage4
Stage4 --> FeatureMap

' MSF Module - Horizontal flow
FeatureMap --> Branch1
FeatureMap --> Branch2
FeatureMap --> Branch3

Branch1 -right-> Concat
Branch2 -right-> Concat
Branch3 -right-> Concat

Concat -right-> Fusion
Fusion -down-> Fused

' Classifier Head - Horizontal flow
Fused -right-> AvgPool
AvgPool -right-> Flatten
Flatten -right-> LN1
LN1 -right-> Drop1
Drop1 -right-> Linear1
Linear1 -right-> GELU1
GELU1 -right-> Drop2
Drop2 -right-> Linear2
Linear2 -right-> GELU2
GELU2 -right-> Drop3
Drop3 -right-> Linear3
Linear3 -down-> Output

@enduml
