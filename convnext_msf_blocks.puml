@startuml ConvNeXt_MSF_Blocks

title Proposed ConvNeXt + MSF Classification Model

skinparam backgroundColor #F5F7FA
skinparam defaultFontName "Segoe UI"
skinparam shadowing false

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #5B5B5B
    RoundCorner 20
    FontColor #1F2A37
    FontSize 14
}

skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #6B7280
    FontColor #111827
    RoundCorner 20
}

skinparam ArrowColor #5B5B5B
skinparam ArrowThickness 2
skinparam ArrowFontColor #111827

package "ConvNeXt Backbone" #E4F1FB {
    rectangle "Input\n320x320x3" as input #FDECEC
    rectangle "Patchify Stem\n4x4 / 4" as stem #DDF1FF
    rectangle "Stage 1\nDWConv7x7 + MLP" as s1 #BDE3FF
    rectangle "Stage 2\nDWConv7x7 + MLP" as s2 #A5D4FF
    rectangle "Stage 3\nDWConv7x7 + MLP" as s3 #8BC4FF
    rectangle "Stage 4\nDWConv7x7 + MLP" as s4 #74B6FF
    rectangle "DropPath + Residual" as resid #5AA4F5
}

input --> stem : conv
stem --> s1
s1 --> s2
s2 --> s3
s3 --> s4
s4 --> resid

package "Multi-Scale Fusion Module" #E6FFF5 {
    rectangle "Branch 3x3\nGrouped Conv -> 1x1\n(fine lesions)" as b3 #C4FAE2
    rectangle "Branch 5x5\nGrouped Conv -> 1x1\n(mid lesions)" as b5 #AAF5D5
    rectangle "Branch 7x7\nGrouped Conv -> 1x1\n(large blights)" as b7 #91F0C8
    rectangle "Concat + LayerNorm\n1x1 Fusion + Residual" as fuse #78EABD
}

resid --> b3
resid --> b5
resid --> b7

b3 --> fuse
b5 --> fuse
b7 --> fuse

package "Classification Head" #FCE4EC {
    rectangle "Adaptive Avg Pool\nFlatten" as gap #FBD3E1
    rectangle "LayerNorm\nLinear 1024->512\nGELU + Dropout" as fc1 #FAB9D1
    rectangle "Linear 512->12\nSoftmax Output" as fc2 #F89FC1
}

fuse --> gap
gap --> fc1
fc1 --> fc2

rectangle "Prediction:\n12 wheat disease classes" as output #E4E7EB
fc2 --> output

rectangle "Vision Transformer Inspiration" as legend_vit #FFEBCD
legend right
Legend
■ ConvNeXt Backbone blocks
■ Multi-Scale Fusion branches
■ Classification head
endlegend

note bottom
  ConvNeXt block math:
  X~ = DWConv7x7(X)
  Z = LN(X~)
  U = W2 * GELU(W1 * Z)
  F = X + DropPath(U)
end note

@enduml

